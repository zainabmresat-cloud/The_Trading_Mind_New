# =====================================================================
# The Trading Mind — .gitignore
# =====================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*.pyo
*.pyc

# pytest cache
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Python egg / distribution
*.egg-info/
dist/
build/
*.egg

# Coverage reports
.coverage
htmlcov/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.user

# Node (if any tooling added later)
node_modules/

# Environment variable files
*.env
.env.local
.env.production

# Logs
*.log
